-dontwarn android.os.ShellCommand
-dontwarn com.android.modules.utils.TypedXmlPullParser
-dontwarn com.android.modules.utils.TypedXmlSerializer
-keep class kotlin.sequences.* # Why is this even needed

# Kept so scripts/check-release-apk.sh can read DEV_TOOLS from the dex: R8
# would otherwise inline the constant and drop the class.
-keep class com.android.virtualization.koiterminal.BuildConfig { *; }

# Dev flavor only (absent from prod): the DevHooks Binder interface.
-keep class io.github.franticplant.koiterminal.dev.api.IDevHooks { *; }
-keep class io.github.franticplant.koiterminal.dev.api.IDevHooks$* { *; }
